# Public URL from which players will open this Playstead installation.
APP_ORIGIN=http://localhost:8080
PLAYSTEAD_PORT=8080

# Generate separate, strong values before the first start.
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=playstead
POSTGRES_DB=playstead

# Optional game rules. A daily time zone should be an IANA name such as
# Europe/Paris; UTC gives every installation the same calendar boundary.
DAILY_TIME_ZONE=UTC
MATCH_ROUND_SECONDS=45
MATCH_REVEAL_SECONDS=8

# Optional build-time satellite XYZ source. Leave unset to serve tiles locally from
# /tiles/satellite/{z}/{x}/{y}.jpg and retain the bundled graphic-map fallback.
# VITE_SATELLITE_TILE_URL=https://your-tile-host/{z}/{x}/{y}.jpg
# VITE_SATELLITE_TILE_ATTRIBUTION=Imagery provider attribution
# VITE_SATELLITE_TILE_MAX_ZOOM=19
