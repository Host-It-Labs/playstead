NODE_ENV=development
PORT=3005
APP_ORIGIN=http://localhost:5174
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_USER=playstead
POSTGRES_DB=playstead
POSTGRES_PASSWORD=playstead
DATABASE_URL=postgresql://playstead:playstead@localhost:55432/playstead
REDIS_URL=redis://localhost:56379
DAILY_TIME_ZONE=UTC
MATCH_ROUND_SECONDS=45
MATCH_REVEAL_SECONDS=8
# Optional when running the frontend without its built-in Vite proxy.
VITE_API_URL=http://localhost:3005/api
VITE_SOCKET_URL=http://localhost:3005
# Development satellite imagery. Replace this XYZ template with your own provider or
# a local /tiles/satellite/{z}/{x}/{y}.jpg endpoint for a fully private installation.
VITE_SATELLITE_TILE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
VITE_SATELLITE_TILE_ATTRIBUTION=Sentinel-2 cloudless · EOX · modified Copernicus Sentinel data 2020
VITE_SATELLITE_TILE_MAX_ZOOM=14
